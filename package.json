{
  "name": "callback-timer",
  "version": "0.2.0",
  "description": "Time how long a callback takes to execute and warn if it exceeds a threshold",
  "license": "MIT",
  "author": "Peter Peterson",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "4.18.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
